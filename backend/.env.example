# ─── GitHub ──────────────────────────────────────────────────────────────────
# Optional — public repos work without a token.
# Provide a Personal Access Token (PAT) for higher rate limits (5000 req/hr vs 60).
# https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
GITHUB_TOKEN=

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Supported providers: gemini
# To add a new provider, implement clients/llm/base.py Protocol and update dependencies.py
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Use the service role key (not the anon key) — backend only, never sent to frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# ─── Analysis limits ─────────────────────────────────────────────────────────
MAX_README_CHARS=2000
MAX_FILES_TO_FETCH=5
MAX_FILE_CHARS=800
MAX_CONCEPTS=20
MIN_CONCEPTS=5
